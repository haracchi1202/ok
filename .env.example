# データベース（開発: SQLite / 本番: PostgreSQL等に変更可能）
DATABASE_URL="file:./dev.db"

# 公開URL（canonical / OGP / sitemap に使用）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 管理画面セッション署名用シークレット（32文字以上のランダム文字列）
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# フォームのBOT対策トークン署名用（未設定時は AUTH_SECRET を使用）
FORM_SECRET=""

# アップロード画像の保存先（公開ディレクトリ外）
UPLOAD_DIR="./storage/uploads"

# メール送信（未設定の場合はコンソール出力 + MailLog テーブルに記録）
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="no-reply@example.com"

# シード時の初期管理者
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin-password-123"
